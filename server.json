{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-16/server.schema.json",
  "name": "io.github.fabienfrfr/pbix-lineage",
  "description": "Bidirectional data lineage graph for Power BI (.pbix) files, from source to display",
  "repository": {
    "url": "https://github.com/fabienfrfr/pbix-lineage",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "pbix-lineage",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:{PBIX_LINEAGE_PORT}/mcp/"
      },
      "environmentVariables": [
        {
          "name": "PBIX_LINEAGE_PORT",
          "description": "Port the server listens on",
          "default": "8080"
        },
        {
          "name": "PBIX_LINEAGE_HOST",
          "description": "Host interface to bind to",
          "default": "127.0.0.1"
        }
      ]
    }
  ]
}